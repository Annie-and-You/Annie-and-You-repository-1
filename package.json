{
  "name": "gesture-dj",
  "private": true,
  "version": "0.1.0",
  "description": "本地手势交互虚拟 DJ：摄像头与手部追踪实验台",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "prepare:tracking": "node scripts/prepare-tracking-assets.mjs",
    "predev": "npm run prepare:tracking",
    "dev": "vite --host localhost",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "npm run prepare:tracking",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host localhost",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
